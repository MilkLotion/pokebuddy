{
  "name": "pokebuddy",
  "version": "0.15.0",
  "private": true,
  "description": "터미널 위에 떠 있는 포켓몬 펫 오버레이 (macOS / Windows)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MilkLotion/pokebuddy.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "terminal",
    "pet",
    "desktop-pet",
    "electron"
  ],
  "main": "dist/main/app.js",
  "bin": {
    "pokebuddy": "bin/pokebuddy"
  },
  "files": [
    "dist/",
    "data/",
    "src/renderer/*.html",
    "src/renderer/styles/",
    "assets/logo/out/",
    "assets/fonts/",
    "assets/items/",
    "helpers/winbounds",
    "helpers/winbounds.ps1",
    "helpers/winbounds.swift",
    "bin/pokebuddy",
    "scripts/postinstall.js",
    "scripts/build-helper.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "scripts": {
    "start": "npm run build && electron .",
    "build:helper": "node scripts/build-helper.js",
    "dist:win": "npm run build && node scripts/build-exe.cjs",
    "dist:mac": "npm run build && node scripts/build-helper.js && node scripts/build-exe.cjs --mac",
    "prepack": "npm run build && node scripts/build-helper.js",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "npm run build",
    "build": "node scripts/clean-dist.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "selftest": "npm run build && node dist/tools/selftest/run.js",
    "dev:account": "npm run build && node dist/tools/dev/dev-test.js start --account",
    "test:e2e": "npm run build && node dist/tools/e2e/e2e-companion.js",
    "verify:build": "npm run build && node dist/tools/data/build-verify.js",
    "data:build": "npm run build && node dist/tools/data/build-dex.js && node dist/tools/data/build-names.js && node dist/tools/data/build-species.js && node dist/tools/data/build-evo.js && node dist/tools/data/build-evo-items.js && node dist/tools/data/build-unlocks.js && node dist/tools/data/build-natures.js && node dist/tools/data/build-items.js && node dist/tools/data/build-dex-text.js",
    "logo:build": "npm run build && node scripts/sync-official-logo.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron": "44.4.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "electron-builder": "^26.15.3",
    "supabase": "^2.118.0",
    "typescript": "^7.0.2"
  }
}
