{
  // 렌더러(브라우저 ESM) — 무대 캔버스 · 스타터 선택 창. src → dist/web (renderer · shared). 메인·CLI·도구는 tsconfig.json
  // src/shared 의 .ts 도 같이 컴파일한다 — 렌더러가 값 모듈(조사 등)을 가져다 쓴다. 메인 빌드의 dist/shared(CommonJS)와 섞이지 않게 출력 폴더를 따로 둔다
  // 값 import 는 ./x.js 확장자로 — 출력이 그대로 브라우저에서 돈다. src/shared 는 node:* 를 쓰지 않는다(types 가 비어 있어 여기서 걸린다)
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist/web",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/renderer/**/*.ts", "src/shared/**/*.ts"]
}
