#!/usr/bin/env node
// pokebuddy — 동반자 띄우기·내리기, 훅 설치, 진단.
//
//   pokebuddy companion [buddy=값] [click=값] | companion stop
//   pokebuddy setup | uninstall | status | game
//
// mac·Windows·npm 전역 설치·git clone 모두 이 파일 하나로 돈다.
// (예전 bash·PowerShell 두 벌은 옵션 해석이 조금씩 어긋나 한 벌로 합쳤다)
// Electron 44 설치기가 Node 22.12 이상을 요구한다. 낮으면 설치는 끝나도 펫이 끝내 뜨지 않으니 먼저 알린다
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 12)) {
  process.stderr.write(`pokebuddy 는 Node.js 22.12 이상이 필요하다 (지금 ${process.versions.node})\n`);
  process.exit(1);
}

// `pokebuddy status | head` 처럼 읽는 쪽이 먼저 닫으면 조용히 끝낸다 (스택을 찍지 않게)
process.stdout.on("error", (e) => {
  if (e.code === "EPIPE") process.exit(0);
  throw e;
});

// 동반자 실행·내리기·진단은 TS 빌드 산출물(dist/terminal — 상태 판정)을 부른다. git clone 뒤 빌드 전이면 여기서 먼저 알린다
// (레지스트리에서 받은 패키지는 dist/ 가 들어 있어 이 줄에 걸리지 않는다)
function needDist() {
  const path = require("path");
  if (require("fs").existsSync(path.join(__dirname, "..", "dist", "cli", "main.js"))) return;
  process.stderr.write("빌드 산출물(dist/)이 없다 — 프로젝트 폴더에서 npm run build 먼저\n");
  process.exit(1);
}

// 명령은 모두 빌드 산출물(dist/cli — 예전 cli/*.js)이다. git clone 직후 dist/ 가 없으면 setup·uninstall 은
// 개발 의존성(tsc)이 있을 때 npm run build 를 한 번 돌린다 — 프로젝트의 dist/ 만 만들고 사용자 홈에는 닿지 않아 --dry-run 에서도 돌린다.
// tsc 가 없으면 needDist 와 같이 알리고 끝낸다 (설계 50번 P1. 예전에는 setup 이 훅 원본을 만들 때 같은 일을 했다)
function ensureDist() {
  const path = require("path");
  const fs = require("fs");
  const root = path.join(__dirname, "..");
  if (fs.existsSync(path.join(root, "dist", "cli", "main.js"))) return;
  const tsc = path.join(root, "node_modules", ".bin", process.platform === "win32" ? "tsc.cmd" : "tsc");
  if (!fs.existsSync(tsc)) needDist();
  process.stdout.write("빌드 산출물(dist/)이 없어 npm run build 를 먼저 돌린다…\n");
  try {
    // npm 은 셸을 거쳐 찾는다 (Windows 의 npm.cmd). 출력은 버린다 — 실패는 파일 유무로 판정
    require("child_process").execSync("npm run build", { cwd: root, stdio: "ignore", timeout: 180_000, windowsHide: true });
  } catch {
    // 아래에서 파일 유무로 판정
  }
  if (fs.existsSync(path.join(root, "dist", "cli", "main.js"))) return;
  process.stderr.write("npm run build 가 실패 — 프로젝트 폴더에서 직접 돌려 오류를 확인한다\n");
  process.exit(1);
}

// 도움말 — 빌드 없이도 답하게 여기 둔다(인자 풀이 src/cli/args.ts 는 빌드 산출물이다)
const USAGE = `사용:
  pokebuddy companion [buddy=값] [click=값]                 동반자 띄우기 — 기기당 하나, 항상 위, 맨 앞 터미널 창을 따른다
  pokebuddy companion stop                                  동반자 내리기
  pokebuddy setup [--dry-run] [--no-editor]                 CLI LLM 상태 훅 설치 (옛 에디터 확장이 있으면 지운다)
  pokebuddy uninstall [--dry-run] [--purge] [--no-editor]   설치한 것 되돌리기 (--purge 면 설정·캐시까지)
  pokebuddy status [포켓몬]                                 지금 판정 상태와 PMD 저작자 보기
  pokebuddy game --help                                    육성·상점·진화 명령 보기
  pokebuddy trade <교환 링크>                               친구 교환 링크로 참가 — 떠 있는 동반자에 보낸다

예:
  pokebuddy companion                 동반자 — 어느 터미널을 보든 그 창의 에이전트 상태를 따른다. 트레이로 끝낸다
  pokebuddy companion buddy=calm      덜 돌아다니게

옵션 (이름=값 · --이름 값):
  buddy=on|calm|off   click=on|off    크기는 저장된 포켓몬 크기를 쓴다`;

// help·version 은 빌드 없이 답한다 — 판정은 src/cli/args.ts parseArgs 의 같은 경우와 같다
// (인자 없음 · 첫 인자 -h · --help → 도움말, help 뒤에 플래그가 없으면 도움말(플래그가 있으면 parseArgs 가 오류로 답한다),
//  첫 인자 -v · --version → 판 번호. 리팩토링 전처럼 git clone 직후에도 돈다)
const argv = process.argv.slice(2);
if (!argv.length || argv[0] === "-h" || argv[0] === "--help" || (argv[0] === "help" && !argv.slice(1).some((a) => a.startsWith("-")))) {
  process.stdout.write(`${USAGE}\n`);
  process.exit(0);
}
if (argv[0] === "-v" || argv[0] === "--version") {
  process.stdout.write(`${require("../package.json").version}\n`);
  process.exit(0);
}

// 그 밖의 명령은 빌드 산출물이다 — setup·uninstall 은 먼저 빌드해 보고, 나머지는 빌드하라고 알린다
// (레지스트리·설치 파일에는 dist/ 가 들어 있어 걸리지 않는다). 명령 가르기는 src/cli/main.ts 의 runCli 다
if (["setup", "uninstall"].includes(argv[0])) ensureDist();
else needDist();
void require("../dist/cli/main.js").runCli(argv, { usage: USAGE, version: require("../package.json").version });
