#!/usr/bin/env node
// pokebuddy — 동반자 띄우기·내리기, 훅 설치, 진단.
//
//   pokebuddy companion [buddy=값] [click=값] | companion stop
//   pokebuddy setup | uninstall | status | game
//
// mac·Windows·npm 전역 설치·git clone 모두 이 파일 하나로 돈다.
// (예전 bash·PowerShell 두 벌은 옵션 해석이 조금씩 어긋나 한 벌로 합쳤다)
// Electron 44 설치기가 Node 22.12 이상을 요구한다. 낮으면 설치는 끝나도 펫이 끝내 뜨지 않으니 먼저 알린다
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 12)) {
  process.stderr.write(`pokebuddy 는 Node.js 22.12 이상이 필요하다 (지금 ${process.versions.node})\n`);
  process.exit(1);
}

// `pokebuddy status | head` 처럼 읽는 쪽이 먼저 닫으면 조용히 끝낸다 (스택을 찍지 않게)
process.stdout.on("error", (e) => {
  if (e.code === "EPIPE") process.exit(0);
  throw e;
});

const { parseArgs, USAGE } = require("../cli/args.js");

// 동반자 실행·내리기·진단은 TS 빌드 산출물(dist/follow — 상태 판정)을 부른다. git clone 뒤 빌드 전이면 여기서 먼저 알린다
// (레지스트리에서 받은 패키지는 dist/ 가 들어 있어 이 줄에 걸리지 않는다)
function needDist() {
  const path = require("path");
  if (require("fs").existsSync(path.join(__dirname, "..", "dist", "follow", "state.js"))) return;
  process.stderr.write("빌드 산출물(dist/)이 없다 — 프로젝트 폴더에서 npm run build 먼저\n");
  process.exit(1);
}

// setup·uninstall 도 경로·설정을 빌드 산출물(dist/platform)에서 읽는다(예전 config.js). git clone 직후 dist/ 가 없으면
// 개발 의존성(tsc)이 있을 때 npm run build 를 한 번 돌린다 — 프로젝트의 dist/ 만 만들고 사용자 홈에는 닿지 않아 --dry-run 에서도 돌린다.
// tsc 가 없으면 needDist 와 같이 알리고 끝낸다 (설계 50번 P1. 예전에는 cli/setup.js 가 훅 원본을 만들 때 같은 일을 했다)
function ensureDist() {
  const path = require("path");
  const fs = require("fs");
  const root = path.join(__dirname, "..");
  if (fs.existsSync(path.join(root, "dist", "platform", "user-config.js"))) return;
  const tsc = path.join(root, "node_modules", ".bin", process.platform === "win32" ? "tsc.cmd" : "tsc");
  if (!fs.existsSync(tsc)) needDist();
  process.stdout.write("빌드 산출물(dist/)이 없어 npm run build 를 먼저 돌린다…\n");
  try {
    // npm 은 셸을 거쳐 찾는다 (Windows 의 npm.cmd). 출력은 버린다 — 실패는 파일 유무로 판정
    require("child_process").execSync("npm run build", { cwd: root, stdio: "ignore", timeout: 180_000, windowsHide: true });
  } catch {
    // 아래에서 파일 유무로 판정
  }
  if (fs.existsSync(path.join(root, "dist", "platform", "user-config.js"))) return;
  process.stderr.write("npm run build 가 실패 — 프로젝트 폴더에서 직접 돌려 오류를 확인한다\n");
  process.exit(1);
}

const parsed = process.argv[2] === "game" ? { kind: "game" } : process.argv[2] === "trade" ? { kind: "trade" } : parseArgs(process.argv.slice(2));

switch (parsed.kind) {
  // 친구 교환 링크로 참가 — 떠 있는 동반자에 game trade.join 으로 보낸다 (docs/work/trade/record.md "링크")
  case "trade":
    needDist();
    if (!process.argv[3]) {
      process.stderr.write("사용: pokebuddy trade <교환 링크>\n");
      process.exitCode = 2;
      break;
    }
    void require("../dist/cli/game.js").game(["trade.join", "-", `link=${process.argv[3]}`]);
    break;
  case "game":
    needDist();
    void require("../dist/cli/game.js").game(process.argv.slice(3));
    break;
  case "help":
    process.stdout.write(`${USAGE}\n`);
    break;
  case "version":
    process.stdout.write(`${require("../package.json").version}\n`);
    break;
  case "setup":
    ensureDist();
    require("../cli/setup.js").setup({ dryRun: parsed.flags.has("--dry-run"), editor: !parsed.flags.has("--no-editor") });
    break;
  case "uninstall":
    ensureDist();
    require("../cli/setup.js").uninstall({
      dryRun: parsed.flags.has("--dry-run"),
      purge: parsed.flags.has("--purge"),
      editor: !parsed.flags.has("--no-editor"),
    });
    break;
  case "status":
    needDist();
    require("../cli/status.js").status(parsed.rest[0]);
    break;
  case "companion":
    if (parsed.error) {
      process.stderr.write(`${parsed.error}\n\n${USAGE}\n`);
      process.exit(2);
    }
    needDist();
    if (parsed.stop) require("../cli/run.js").companionStop();
    else require("../cli/run.js").companion(parsed.opts || {});
    break;
  default:
    process.stderr.write(`${parsed.error || "알 수 없는 명령"}\n\n${USAGE}\n`);
    process.exit(2);
}
